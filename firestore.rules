rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        (request.auth.token.email_verified == true && request.auth.token.email == 'rayansportsofficial@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }

    // Phase 2: Validation Blueprints
    function isValidInquiry(data) {
      return data.keys().hasAll(['productName', 'quantity', 'size', 'fabric', 'printingMethod', 'name', 'email', 'phone', 'country', 'status', 'createdAt'])
        && data.keys().size() >= 11
        && data.keys().size() <= 13 // message and logoUrl are optional
        && data.productName is string && data.productName.size() <= 200
        && data.quantity is string && data.quantity.size() <= 100
        && data.size is string && data.size.size() <= 50
        && data.fabric is string && data.fabric.size() <= 100
        && data.printingMethod is string && data.printingMethod.size() <= 100
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.phone is string && data.phone.size() <= 50
        && data.country is string && data.country.size() <= 100
        && data.status is string && data.status.matches('^(new|contacted)$')
        && data.createdAt == request.time
        && (!('message' in data) || (data.message is string && data.message.size() <= 2000))
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 500));
    }

    function checkAdmin(data) {
      return data.keys().hasAll(['email', 'role'])
        && data.keys().size() == 2
        && data.email is string && data.email.size() <= 150
        && data.role is string && data.role == 'superadmin';
    }

    function isStatusUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['status']);
    }

    function isValidSlide(data) {
      return data.keys().hasAll(['image', 'title', 'subtitle', 'buttonText', 'buttonLink', 'enabled', 'order'])
        && data.image is string && data.image.size() <= 1000
        && data.title is string && data.title.size() <= 200
        && data.subtitle is string && data.subtitle.size() <= 500
        && data.buttonText is string && data.buttonText.size() <= 50
        && data.buttonLink is string && data.buttonLink.size() <= 200
        && data.enabled is bool
        && data.order is number;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'slug', 'image', 'description', 'createdAt'])
        && data.name is string && data.name.size() <= 100
        && data.slug is string && data.slug.size() <= 100 && data.slug.matches('^[a-z0-9-]+$')
        && data.image is string && data.image.size() <= 1000
        && data.description is string && data.description.size() <= 2000
        && data.createdAt == request.time
        && (string.length(data.get('parentId', '')) <= 128);
    }

    function isValidCategoryUpdate(incomingData, existingData) {
      return incomingData.keys().hasAll(['name', 'slug', 'image', 'description', 'createdAt'])
        && incomingData.name is string && incomingData.name.size() <= 100
        && incomingData.slug is string && incomingData.slug.size() <= 100 && incomingData.slug.matches('^[a-z0-9-]+$')
        && incomingData.image is string && incomingData.image.size() <= 1000
        && incomingData.description is string && incomingData.description.size() <= 2000
        && incomingData.createdAt == existingData.createdAt
        && (string.length(incomingData.get('parentId', '')) <= 128);
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['categoryId', 'name', 'slug', 'image', 'description', 'features', 'createdAt'])
        && data.categoryId is string && data.categoryId.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.slug is string && data.slug.size() <= 200 && data.slug.matches('^[a-z0-9-]+$')
        && data.image is string && data.image.size() <= 1000
        && data.description is string && data.description.size() <= 10000
        && data.features is list && data.features.size() <= 20
        && (data.features.size() == 0 || data.features[0] is string)
        && data.createdAt == request.time
        && (data.get('videoUrl', '') is string && string.length(data.get('videoUrl', '')) <= 1000)
        && (data.get('mediaUrls', []) is list && data.get('mediaUrls', []).size() <= 10)
        && (data.get('price', '') is string && string.length(data.get('price', '')) <= 100)
        && (data.get('sku', '') is string && string.length(data.get('sku', '')) <= 100)
        && (data.get('isActive', true) is bool)
        && (data.get('articles', []) is list && data.get('articles', []).size() <= 100);
    }

    function isValidProductUpdate(incomingData, existingData) {
      return incomingData.keys().hasAll(['categoryId', 'name', 'slug', 'image', 'description', 'features', 'createdAt'])
        && incomingData.categoryId is string && incomingData.categoryId.size() <= 128
        && incomingData.name is string && incomingData.name.size() <= 200
        && incomingData.slug is string && incomingData.slug.size() <= 200 && incomingData.slug.matches('^[a-z0-9-]+$')
        && incomingData.image is string && incomingData.image.size() <= 1000
        && incomingData.description is string && incomingData.description.size() <= 10000
        && incomingData.features is list && incomingData.features.size() <= 20
        && (incomingData.features.size() == 0 || incomingData.features[0] is string)
        && incomingData.createdAt == existingData.createdAt
        && (incomingData.get('videoUrl', '') is string && string.length(incomingData.get('videoUrl', '')) <= 1000)
        && (incomingData.get('mediaUrls', []) is list && incomingData.get('mediaUrls', []).size() <= 10)
        && (incomingData.get('price', '') is string && string.length(incomingData.get('price', '')) <= 100)
        && (incomingData.get('sku', '') is string && string.length(incomingData.get('sku', '')) <= 100)
        && (incomingData.get('isActive', true) is bool)
        && (incomingData.get('articles', []) is list && incomingData.get('articles', []).size() <= 100);
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming());
      allow update: if isValidId(categoryId) && isAdmin() && isValidCategoryUpdate(incoming(), existing());
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow create: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow update: if isValidId(productId) && isAdmin() && isValidProductUpdate(incoming(), existing());
      allow delete: if isValidId(productId) && isAdmin();
    }

    // Slideshow Collection
    match /slideshow/{slideId} {
      allow read: if true;
      allow create: if isValidId(slideId) && isAdmin() && isValidSlide(incoming());
      allow update: if isValidId(slideId) && isAdmin() && isValidSlide(incoming());
      allow delete: if isValidId(slideId) && isAdmin();
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['orderNumber', 'customerName', 'customerEmail', 'items', 'totalAmount', 'status', 'createdAt'])
        && data.orderNumber is string && data.orderNumber.size() <= 100
        && data.customerName is string && data.customerName.size() <= 100
        && data.customerEmail is string && data.customerEmail.size() <= 100
        && data.items is list && data.items.size() <= 100
        && data.totalAmount is number
        && data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled']
        && data.createdAt == request.time;
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isValidId(orderId) && isAdmin() 
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'trackingNumber', 'updatedAt'])
        && incoming().status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'];
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Inquiries Collection
    match /inquiries/{inquiryId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      
      allow update: if isValidId(inquiryId) && isAdmin() && isStatusUpdate()
                    && incoming().createdAt == existing().createdAt
                    && incoming().productName == existing().productName
                    && incoming().name == existing().name
                    && incoming().status in ['new', 'contacted'];
      
      allow delete: if isValidId(inquiryId) && isAdmin();
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['companyName', 'contactWhatsapp', 'contactEmail', 'footerAddress'])
        && data.companyName is string && data.companyName.size() <= 100
        && data.contactWhatsapp is string && data.contactWhatsapp.size() <= 20
        && data.contactEmail is string && data.contactEmail.size() <= 100
        && data.footerAddress is string && data.footerAddress.size() <= 200
        && (string.length(data.get('logoUrl', '')) <= 1000)
        && (data.get('maintenanceMode', false) is bool);
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow create: if isValidId(settingId) && isAdmin() && isValidSettings(incoming());
      allow update: if isValidId(settingId) && isAdmin() && isValidSettings(incoming());
      allow delete: if false;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt'])
        && data.email is string && data.email.size() <= 200
        && data.role is string && data.role in ['admin', 'manager', 'editor', 'viewer']
        && data.createdAt == request.time;
    }

    function isValidUserUpdate(incomingData, existingData) {
      return incomingData.keys().hasAll(['email', 'role', 'createdAt'])
        && incomingData.email is string && incomingData.email.size() <= 200
        && incomingData.role is string && incomingData.role in ['admin', 'manager', 'editor', 'viewer']
        && incomingData.createdAt == existingData.createdAt;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isAdmin() && incoming().keys().hasOnly(['email', 'role']) && incoming().email is string && incoming().email.size() <= 200 && incoming().role is string && incoming().role.size() <= 100;
      allow update: if false; // Immutable roles
      allow delete: if isAdmin() && adminId != request.auth.uid; // Manual removal only
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidUser(incoming());
      allow update: if isAdmin() && isValidUserUpdate(incoming(), existing());
      allow delete: if isAdmin() && userId != request.auth.uid;
    }
    function isValidPage(data) {
      return data.keys().hasAll(['title', 'slug', 'content', 'metaDescription', 'isActive', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() <= 200
        && data.slug is string && data.slug.size() <= 200 && data.slug.matches('^[a-z0-9-]+$')
        && data.content is string && data.content.size() <= 50000
        && data.metaDescription is string && data.metaDescription.size() <= 500
        && data.isActive is bool
        && data.updatedAt is timestamp;
    }

    match /pages/{pageId} {
      allow read: if true;
      allow create: if isValidId(pageId) && isAdmin() && isValidPage(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(pageId) && isAdmin() && isValidPage(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(pageId) && isAdmin();
    }
  }
}
